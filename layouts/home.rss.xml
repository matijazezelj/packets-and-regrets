{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    <language>{{ site.Language.Locale }}</language>
    <atom:link href="{{ (site.Home.OutputFormats.Get "RSS").Permalink }}" rel="self" type="application/rss+xml" />
    {{- with (index (where site.RegularPages "Section" "posts") 0) }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}
    {{- range first 20 (where site.RegularPages "Section" "posts") }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Description | default .Summary | plainify }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
