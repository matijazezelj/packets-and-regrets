{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "packets-and-regrets",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "blog.zezelj.org",
      "custom_domain": true
    }
  ]
}
